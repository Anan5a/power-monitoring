# ── Server ──────────────────────────────────────
API_PORT=8080
INGEST_PORT=9090
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────
DATABASE_URL=postgres://powermon:powermon@postgres:5432/powermon?sslmode=disable

# ── ClickHouse ──────────────────────────────────
CLICKHOUSE_URL=clickhouse://clickhouse:9000/powermon?dial_timeout=10s

# ── MQTT ────────────────────────────────────────
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=iot-platform-ingest
# Optional service credentials for api + ingest.
# Required when Mosquitto uses password-file auth; leave empty for
# the test config (mosquitto-test.conf) which allows anonymous connections.
# MQTT_USER=powermon
# MQTT_PASSWORD=powermon

# ── JWT ─────────────────────────────────────────
# DEV ONLY — this default is committed for local development. Replace with a
# fresh `openssl rand -hex 32` output for any shared/production deployment.
JWT_SECRET=dev-only-7f3a9c2e1b04d6e8a5f1c0b2d3e4f5a60718293a4b5c6d7e8f901a2b3c4d5e6f
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ── MinIO ───────────────────────────────────────
# Note: the MinIO S3 API is exposed on host port 9002 (container port 9000).
# The console is on host port 9003 (container port 9001).
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=firmware
# Device-reachable base URL for OTA firmware downloads. The internal
# MINIO_ENDPOINT is not reachable from devices. For local dev, MinIO's S3 API
# is on host port 9002. In prod, set this to the public firmware download URL.
MINIO_PUBLIC_URL=http://localhost:9002

# ── SMTP (optional, Phase 2) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iotplatform.local

# ── OAuth (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:8080

# ── CORS ────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auto-migrate ────────────────────────────────
AUTO_MIGRATE=true

# ── Production overlay (docker-compose.prod.yml) ────────────────
# Required only when running the prod overlay.
# DOMAIN=iot.example.com
# TRAEFIK_ACME_EMAIL=ops@example.com
# POSTGRES_PASSWORD=<strong>
# CLICKHOUSE_PASSWORD=<strong>
# These override MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above in prod.
