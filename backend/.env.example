# ── Server ──────────────────────────────────────
API_PORT=8080
INGEST_PORT=9090
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────
DATABASE_URL=postgres://powermon:powermon@postgres:5432/powermon?sslmode=disable

# ── ClickHouse ──────────────────────────────────
CLICKHOUSE_URL=clickhouse://clickhouse:9000/powermon?dial_timeout=10s

# ── MQTT ────────────────────────────────────────
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=iot-platform-ingest
# Optional service credentials for api + ingest.
# Required when Mosquitto uses password-file auth; leave empty for
# the test config (mosquitto-test.conf) which allows anonymous connections.
# MQTT_USER=powermon
# MQTT_PASSWORD=powermon

# ── JWT ─────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ── MinIO ───────────────────────────────────────
# Note: the MinIO S3 API is exposed on host port 9002 (container port 9000).
# The console is on host port 9003 (container port 9001).
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=firmware

# ── SMTP (optional, Phase 2) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iotplatform.local

# ── OAuth (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:8080

# ── CORS ────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auto-migrate ────────────────────────────────
AUTO_MIGRATE=true
